# BlastradiusAI Environment Configuration
# Add your Gemini API key below to enable full autonomous LLM reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# FalkorDB Configuration (Optional: FalkorDB Cloud or local Redis/FalkorDB Docker)
# If FalkorDB is not reachable, the system automatically uses the embedded topological Cypher engine
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=cloud_infra
